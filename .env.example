# Somente configuração local; não colocar PATs ou dados de pacientes neste arquivo.
EXTRACTOR_MODEL=qwen3:4b
OLLAMA_HOST=http://127.0.0.1:11434
EXTRACTOR_CONTEXT_TOKENS=2048
EXTRACTOR_TIMEOUT_SECONDS=60
EXTRACTOR_DB_PATH=data/extractions.sqlite3
# Estas opções são usadas pelo daemon Ollama, não pelo SDK do extrator.
OLLAMA_NO_CLOUD=1
OLLAMA_MODELS=.local-runtime/models
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_CONTEXT_LENGTH=2048

# Shell: padrões iniciais; alterações no menu ficam somente em memória.
SHELL_ROUTER_MODEL=qwen3:0.6b
SHELL_ROUTER_TIMEOUT_SECONDS=15

# Segurança, Criptografia e LGPD (Lei 13.709/2018):
# Ativa criptografia em repouso dos relatos íntimos e desabafos (AES-128 Fernet + HMAC-SHA256)
ENABLE_DIARY_ENCRYPTION=true
# Chave mestra Fernet URL-safe de 32 bytes base64 (opcional; se vazia, gerada localmente em .diary_encryption.key)
# Suporta rotação de chaves separadas por vírgula: "chave_nova,chave_antiga"
# DIARY_ENCRYPTION_KEY=
